NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server and seed scripts only
GEMINI_API_KEY=                   # empty = AI features use their fallback
GEMINI_MODEL=                     # the newest Gemini Flash model on the team account
OPENROUTER_API_KEY=               # optional: call Gemini through OpenRouter instead (wins over GEMINI_API_KEY)
DEMO_MODE=false                   # true = extraction uses saved results, no LLM
PLATFORM_FEE_PERCENT=20
